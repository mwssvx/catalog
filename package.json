{
  "name": "catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env.local server/index.ts",
    "build": "vite build && node scripts/build-vercel-api.mjs",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:catalog": "tsx --env-file=.env.local scripts/migrate-catalog-json.ts",
    "migrate:sql": "tsx --env-file=.env.local scripts/apply-migrations.ts",
    "schema:check": "tsx --env-file=.env.local scripts/check-schema.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@hono/node-server": "^1.19.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.1",
    "hono": "^4.9.6",
    "i18next": "^25.5.2",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.8.2",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
