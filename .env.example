# Public Supabase URL and anon key (server-loaded; SPA talks only to /api).
# Prefer SUPABASE_* names. NEXT_PUBLIC_* still accepted for one release.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security. Used by the JSON migration script.
# Never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public catalog shop slug (first release is one shop).
PUBLIC_SHOP_SLUG=dordoi

# Seller WhatsApp digits if the shop row has none. Country code, no + or spaces.
SHOP_WHATSAPP=996XXXXXXXXX

# Optional. Used by `npm run migrate:sql` and schema checks.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-ref.supabase.co:5432/postgres

API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
