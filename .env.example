# Seller studio login. Use a private password in .env.local — never commit the real value.
STUDIO_PASSWORD=replace-with-a-private-studio-password

# Seller WhatsApp number for customer contact. Digits only, country code, no + or spaces.
SHOP_WHATSAPP=996XXXXXXXXX

# Optional. Leave empty to keep Open Board fully manual. Do not paste a live key here.
OPENAI_API_KEY=

# Optional. Used only when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini
