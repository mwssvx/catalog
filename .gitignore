# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
credentials.json
secrets.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and secrets — never commit these
.env
.env.*
.env.local
!.env.example

# temporary files
*.tmp
*.temp
*.swp
*~
.cache

# local recovery copies (not the source of truth)
/backups/

# private uploaded seller media
/public/uploads/*
!/public/uploads/.gitkeep

# vercel / railway local
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
